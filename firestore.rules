rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read/write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Clients collection - admins can manage, authenticated users can read
    match /clients/{clientId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }

    // Caregivers collection - admins can manage, authenticated users can read
    match /caregivers/{caregiverId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }

    // Shifts collection - specific rules for shift management
    match /shifts/{shiftId} {
      // Allow read for authenticated users
      allow read: if request.auth != null;

      // Allow create for admins
      allow create: if request.auth != null && request.auth.token.role == 'admin';

      // Allow update for admins and mobile app clock in/out
      allow update: if request.auth != null && (
        request.auth.token.role == 'admin' ||
        // Allow mobile app to update clockInTime, clockOutTime, and hoursWorked
        (request.auth.token.role == 'caregiver' &&
         request.resource.data.caregiverId == request.auth.uid &&
         // Only allow updating specific fields for clock operations
         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['clientId', 'serviceType', 'startTime', 'endTime', 'location', 'status', 'createdBy', 'createdAt', 'allowOverlap', 'deleted'])) &&
         // Ensure status transitions are valid for clock operations
         (resource.data.status in ['Scheduled', 'Late', 'In Progress'] || request.resource.data.status == 'In Progress'))
      );

      // Allow delete for admins only
      allow delete: if request.auth != null && request.auth.token.role == 'admin';
    }

    // Incidents collection
    match /incidents/{incidentId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }

    // Shift notes collection
    match /shiftNotes/{noteId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }

    // Reports collection
    match /reports/{reportId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }

    // Allow all operations for testing (remove in production)
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
